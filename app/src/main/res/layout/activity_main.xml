<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla principal:
  • Barra superior: nombre del launcher (izquierda) + acceso a Ajustes, acceso a WiFi y hora (derecha),
    todo a la misma altura.
  • Debajo, el contenedor del HomeFragment (BrowseSupportFragment de Leanback).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/barra_superior"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/fondo"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingEnd="48dp">

        <TextView
            android:id="@+id/nombre_launcher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/titulo_inicio"
            android:textColor="@color/amarillo_foco"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btn_ajustes"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_boton_barra"
            android:clickable="true"
            android:contentDescription="@string/ajustes"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ajustes" />

        <ImageView
            android:id="@+id/btn_wifi"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_boton_barra"
            android:clickable="true"
            android:contentDescription="@string/wifi"
            android:focusable="true"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_wifi" />

        <TextClock
            android:id="@+id/reloj"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:format12Hour="h:mm a"
            android:format24Hour="HH:mm"
            android:textColor="@color/texto"
            android:textSize="30sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/amarillo_foco" />

    <!-- Contenedor del HomeFragment (BrowseSupportFragment de Leanback) -->
    <FrameLayout
        android:id="@+id/contenedor_home"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo" />
</LinearLayout>
